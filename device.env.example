# Copy this file to device.env and fill in the values for each frame.

PORT=5002
SANNY_APP_TITLE="Sanny Photos"

# Shared cross-frame room.
SANNY_ROOM_ID=sanny-photos
SANNY_SYNC_MUSIC=1

# Slideshow defaults.
SANNY_DEFAULT_SLIDE_DURATION_MS=12000
SANNY_DEFAULT_PLAYLIST_URL=https://www.youtube.com/playlist?list=PLcFTWWe4qhjxOcfXhNAMwV5SiusiZAKQI

# Optional: keep the I2S/PipeWire audio path stable across track changes.
SANNY_MPV_AUDIO_OUTPUT=pulse
SANNY_MPV_GAPLESS_AUDIO=yes
SANNY_MPV_AUDIO_STREAM_SILENCE=yes
SANNY_MPV_AUDIO_SAMPLERATE=48000
SANNY_MPV_AUDIO_CHANNELS=stereo
SANNY_MPV_AUDIO_FORMAT=s16
SANNY_MPV_AUDIO_BUFFER=0.5
SANNY_MPV_LOAD_GUARD_SECONDS=6

# Local storage paths.
SANNY_IMAGES_DIR=/home/me/coding/own/sanny_photos/static/images
SANNY_ALBUM_PATH=/home/me/coding/own/sanny_photos/album.json
SANNY_GOOGLE_TOKEN_PATH=/home/me/coding/own/sanny_photos/creds/token.json

# Optional: tune large-library local caching.
SANNY_IMAGE_MAX_EDGE=1920
SANNY_IMAGE_QUALITY=85
# SANNY_DRIVE_HTTP_TIMEOUT_SECONDS=90
# SANNY_DRIVE_DOWNLOAD_RETRIES=2
# SANNY_SYNC_INDEX_PATH=/home/me/coding/own/sanny_photos/.drive_sync_index.json

# Optional: rename the Google Drive folder or setup hotspot.
SANNY_DRIVE_FOLDER_NAME=Sanny Photos
SANNY_SETUP_SSID_PREFIX="Sanny Setup"

# Firebase room sync.
SANNY_FIREBASE_API_KEY=
SANNY_FIREBASE_AUTH_DOMAIN=
SANNY_FIREBASE_DATABASE_URL=
SANNY_FIREBASE_PROJECT_ID=
SANNY_FIREBASE_STORAGE_BUCKET=
SANNY_FIREBASE_MESSAGING_SENDER_ID=
SANNY_FIREBASE_APP_ID=
